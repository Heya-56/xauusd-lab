# Hinova signal engine (Python stdlib only). Deploy behind the accounts Worker; never public-facing
# without HMAC: the Worker signs every request with HINOVA_ENGINE_SECRET.
FROM python:3.12-slim
RUN useradd --create-home --uid 10001 engine
WORKDIR /app
COPY src/ ./src/
COPY config/ ./config/
USER engine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HINOVA_ENGINE_PORT=8090
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8090/healthz',timeout=2).status==200 else 1)"
CMD ["python", "-m", "src.api.engine_http"]
